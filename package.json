{
  "name": "arkadia-dargoth-arkmail",
  "private": true,
  "type": "commonjs",
  "description": "ArkMail - kompleksowy system pocztowy dla klienta Dargoth (Arkadia MUD)",
  "scripts": {
    "bundle": "node scripts/bundle.mjs",
    "build": "node scripts/build.js",
    "release": "node scripts/release.mjs",
    "test": "tsc -p tsconfig.test.json && node --test --test-concurrency=1 out-test/tests/*.test.js tests/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "esbuild": "^0.24.0",
    "happy-dom": "^21.0.3",
    "typescript": "^5.6.0"
  }
}
